{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "mumo",
  "version": "0.2.1",
  "description": "Multi-model deliberation panel. Diverse AI voices + claim-level reactions on contested decisions.",
  "author": {
    "name": "Sourced LLC",
    "url": "https://mumo.chat"
  },
  "homepage": "https://mumo.chat/install",
  "repository": {
    "type": "git",
    "url": "https://github.com/mumo-chat/mumo-mcp.git"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "deliberation",
    "multi-model",
    "claude",
    "gpt",
    "gemini",
    "panel",
    "architecture",
    "design-review",
    "code-review"
  ],
  "mcpServers": "../.mcp.json",
  "userConfig": {
    "api_key": {
      "type": "string",
      "title": "mumo API Key",
      "description": "Platform key from https://mumo.chat/settings/api-keys (starts with mmo_live_)",
      "sensitive": true,
      "required": true
    }
  }
}
